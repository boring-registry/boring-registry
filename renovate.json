{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "30 days",
      "automerge": true
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "60 days",
      "automerge": true
    },
    {
      "schedule": [
        "on monday"
      ],
      "groupName": "aws-sdk-go-v2",
      "matchPackageNames": [
        "github.com/aws/aws-sdk-go-v2{/,}**"
      ]
    },
    {
      "schedule": [
        "every month"
      ],
      "matchPackageNames": [
        "google.golang.org/genproto{/,}**"
      ]
    },
    {
      "schedule": [
        "every month"
      ],
      "matchPackageNames": [
        "golang.org/x/oauth2{/,}**",
        "golang.org/x/sync{/,}**"
      ]
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "schedule": [
        "* 2 * * 0"
      ],
      "groupName": "go version",
      "groupSlug": "go-version"
    }
  ]
}
